# Copy to .env.local for local dev. In production these live in Vercel's env vars.
# None of these are secrets, but keep the real values out of the repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The owner's Firebase Auth UID. Leave empty until the first sign-in;
# the Locked screen shows the UID to copy while this is empty.
VITE_OWNER_UID=
