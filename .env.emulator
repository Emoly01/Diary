# For `npm run dev:emulator`: talks to the local Firebase emulators only.
# These are demo values, not a real project.
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-daybook.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-daybook
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
# Same UID as firestore.rules, so the emulator user created with it is the owner.
VITE_OWNER_UID=glsvsh2xl7R7DkH2mLFqID7GDv73
